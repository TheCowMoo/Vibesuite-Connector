# ---- Runtime ----
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ---- Redis ----
# Inside Docker Compose this is overridden to redis://redis:6379 (see docker-compose.yml).
# The localhost value below is only for running the app OUTSIDE Docker (npm run dev:*).
REDIS_URL=redis://127.0.0.1:6379

# ---- Public endpoints ----
# Origin used for OAuth redirect URIs + dashboard links (e.g. https://sync.yourdomain.com)
OAUTH_BASE_URL=https://sync.yourdomain.com
# Global Google push notification endpoint (must match the nginx SSL endpoint)
GOOGLE_WEBHOOK_URL=https://sync.yourdomain.com/webhooks/google/calendar

# ---- OAuth apps (required only for the OAuth onboarding flows) ----
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_PATH=/oauth/google/callback
GHL_OAUTH_CLIENT_ID=
GHL_OAUTH_CLIENT_SECRET=
# GHL_OAUTH_REDIRECT_PATH=/oauth/ghl/callback

# ---- Security ----
# Recommend setting a strong random key so stored OAuth/API tokens are encrypted at rest.
CREDENTIALS_ENCRYPTION_KEY=

# ---- Seed connection (used by `npm run seed` only) ----
GOOGLE_CALENDAR_ID=primary
GOOGLE_SERVICE_ACCOUNT_FILE=/run/secrets/gcal-sa.json
# OR inline:
# GOOGLE_SERVICE_ACCOUNT_EMAIL=svc@your-project.iam.gserviceaccount.com
# GOOGLE_SERVICE_ACCOUNT_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
GOOGLE_SUBJECT=calendar-owner@yourdomain.com

GHL_API_TOKEN=your-private-integration-token
GHL_BASE_URL=https://services.leadconnectorhq.com
GHL_VERSION=2021-07-28
GHL_LOCATION_ID=your-location-id
GHL_WEBHOOK_YES=https://services.leadconnectorhq.com/hooks/xxxx-yes
GHL_WEBHOOK_MAYBE=https://services.leadconnectorhq.com/hooks/xxxx-maybe
GHL_WEBHOOK_NO=https://services.leadconnectorhq.com/hooks/xxxx-no
GHL_RSVP_CUSTOM_FIELD_ID=

# ---- Watch / Sync tuning ----
WATCH_TTL_SECONDS=2592000
WATCH_RENEWAL_THRESHOLD_DAYS=5
WATCH_RENEWAL_CHECK_INTERVAL_MS=86400000
LOCK_TTL_SECONDS=5
SYNC_QUEUE_NAME=sync-queue
WORKER_CONCURRENCY=5
METRICS_PORT=9090
SYNC_RETRY_ATTEMPTS=5
SYNC_BACKOFF_DELAY_MS=2000

# ---- Mass invite tuning ----
INVITE_BATCH_SIZE=100
INVITE_DELAY_MS=300
